{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest --run",
		"test:unit": "vitest",
		"types:generate": "cd ../backend && go run github.com/gzuidhof/tygo@latest generate && cd ../frontend && prettier --write src/lib/types/models.ts src/lib/types/api.ts && echo 'TypeScript types generated from Go models'"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-auto": "8.0.1",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@vitest/browser-playwright": "4.1.12",
		"daisyui": "5.8.0",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "3.5.2",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "2.2.1"
	},
	"dependencies": {
		"@lucide/svelte": "0.577.0",
		"@tailwindcss/typography": "0.5.20",
		"@thisux/sveltednd": "0.0.20",
		"theme-change": "2.5.2"
	},
	"overrides": {
		"@tailwindcss/typography": {
			"postcss-selector-parser": "6.1.6"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
