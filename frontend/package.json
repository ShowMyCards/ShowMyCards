{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "eslint . && prettier --check .",
		"test": "vitest --run",
		"test:unit": "vitest",
		"types:generate": "cd ../backend && go run github.com/gzuidhof/tygo@latest generate && cd ../frontend && prettier --write src/lib/types/models.ts src/lib/types/api.ts && echo 'TypeScript types generated from Go models'"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "^4.1.6",
		"daisyui": "^5.5.20",
		"eslint": "^10.4.0",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.55.8",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^7.3.3",
		"vitest": "^4.1.6",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@lucide/svelte": "^0.577.0",
		"@tailwindcss/typography": "^0.5.19",
		"@thisux/sveltednd": "^0.0.20",
		"sveltekit-sse": "^0.14.3",
		"theme-change": "^2.5.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.5",
		"cookie": "^0.7.2",
		"flatted": "^3.4.0",
		"picomatch": "^4.0.4",
		"postcss": "^8.5.10",
		"yaml": "^1.10.3"
	}
}
